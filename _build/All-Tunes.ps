		CharStrings/double_sharp{pop 460 0 setcharwidth udblesharp ufill}bind put
		CharStrings/double_flat{pop 500 0 setcharwidth udbleflat ufill}bind put
	    }ifelse
	}if currentdict definefont pop end}!
